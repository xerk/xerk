# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://www.xerk.io
NEXT_PUBLIC_UPWORK_URL=            # your Upwork profile URL
NEXT_PUBLIC_BOOKING_URL=           # Cal.com / Calendly link (defaults to mailto)

# ---- Admin CMS (/admin, /studio) ----
# Supabase Auth magic link. Only these emails (comma-separated) can sign in; defaults to gm.xerk@gmail.com.
ADMIN_EMAILS=gm.xerk@gmail.com

# ---- Supabase (content, leads, visits) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- PostHog ----
NEXT_PUBLIC_POSTHOG_KEY=           # project API key (phc_...)
NEXT_PUBLIC_POSTHOG_HOST=https://us.posthog.com
POSTHOG_PERSONAL_API_KEY=          # for /stats + daily digest (query:read)
POSTHOG_PROJECT_ID=

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=                # from @BotFather
TELEGRAM_CHAT_ID=                  # your chat id (message @userinfobot)
TELEGRAM_WEBHOOK_SECRET=           # any random string; used when registering the webhook
TELEGRAM_VISIT_PINGS=all           # all | notable | off

# ---- Cron ----
CRON_SECRET=                       # Vercel sends it as Bearer token to /api/cron/digest

# ---- AI (Ask my CV) ----
AI_GATEWAY_API_KEY=                # Vercel AI Gateway; on Vercel, OIDC works without it
AI_MODEL=anthropic/claude-sonnet-5.5

# ---- GitHub heatmap (optional, live data) ----
GITHUB_TOKEN=

# ---- Postiz (post.xerk.io) ----
POSTIZ_API_URL=https://post.xerk.io/api
POSTIZ_API_KEY=
